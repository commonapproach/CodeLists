    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator1",
      "@type": "cids:Indicator",
      "hasName": "Are your products/services designed to support equity-deserving groups, and promote social equity?",
      "label": {
        "en": "Are your products/services designed to support equity-deserving groups, and promote social equity?",
        "fr": "Vos produits/services sont-ils conçus pour soutenir les groupes méritant l'équité et promouvoir l'équité sociale ?"
      },
      "hasDescription": "Products or/and services are designed by the social purpose organization to target initiatives advancing social equity and the well-being of equity-deserving groups.",
      "comment": {
        "en": "Products or/and services are designed by the social purpose organization to target initiatives advancing social equity and the well-being of equity-deserving groups.",
        "fr": "Les produits et/ou services sont conçus par l'organisme à vocation sociale de manière à cibler des initiatives visant à promouvoir l'équité sociale et le bien-être des groupes méritant l'équité."
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome1"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator2",
      "@type": "cids:Indicator",
      "hasName": "Are your products/services designed to support women or/and gender-diverse people, and promote gender equality?",
      "label": {
        "en": "Are your products/services designed to support women or/and gender-diverse people, and promote gender equality?",
        "fr": "Vos produits/services sont-ils conçus pour soutenir les femmes et/ou les  personnes de diverses identités de genre, et faire avancer l'égalité des genres?"
      },
      "hasDescription": "Products or/and services are designed by the social purpose organization to target initiatives advancing gender equality and the well-being of women and gender diverse people.",
      "comment": {
        "en": "Products or/and services are designed by the social purpose organization to target initiatives advancing gender equality and the well-being of women and gender diverse people.",
        "fr": "Les produits et/ou services sont conçus par l'intermédiaire de finance sociale de manière à cibler des initiatives visant à promouvoir l'égalité des genres et l'équité des femmes et des personnes de diverses identités de genre."
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome1"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator3",
      "@type": "cids:Indicator",
      "hasName": "Do you integrate a social equity analysis while developing your prodcts/services?",
      "label": {
        "en": "Do you integrate a social equity analysis while developing your prodcts/services?",
        "fr": "Intégrez-vous une analyse d'équité sociale lors du développement de vos produits et/ou services?"
      },
      "hasDescription": "The social purpose organization conducts a social equity analysis in the development of their products or/and services, and integrates mitigation strategies as applicable.",
      "comment": {
        "en": "The social purpose organization conducts a social equity analysis in the development of their products or/and services, and integrates mitigation strategies as applicable.",
        "fr": "L'organisme à vocation sociale effectue une analyse d'équité sociale dans le cadre du développement de ses produits et/ou services, et intègre des stratégies d'atténuation le cas échéant."
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome1"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator4",
      "@type": "cids:Indicator",
      "hasName": "Do you integrate a gender analysis while developing your products/services?",
      "label": {
        "en": "Do you integrate a gender analysis while developing your products/services?",
        "fr": "Intégrez-vous une analyse de genre lors du développement de vos produits et services?"
      },
      "hasDescription": "The social purpose organization conducts a gender equality analysis in the development of their products or/and services, and integrates mitigation strategies as applicable.",
      "comment": {
        "en": "The social purpose organization conducts a gender equality analysis in the development of their products or/and services, and integrates mitigation strategies as applicable.",
        "fr": "L'organisme à vocation sociale effectue une analyse de genre dans le cadre du développement de ses produits et/ou services, et intègre des stratégies d'atténuation le cas échéant."
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome1"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator5",
      "@type": "cids:Indicator",
      "hasName": "Is your leadership* (i.e. founder, owner, and/or senior management) composed of member(s) of an equity-deserving group?",
      "label": {
        "en": "Is your leadership* (i.e. founder, owner, and/or senior management) composed of member(s) of an equity-deserving group?",
        "fr": "Votre leadership* (c'est-à-dire le fondateur, le propriétaire et/ou les cadres supérieurs) est-il composé de membre(s) issues de groupes méritant l'équité?"
      },
      "hasDescription": "Leadership of the social purpose organization includes lived experience from equity-deserving groups.",
      "comment": {
        "en": "Leadership of the social purpose organization includes lived experience from equity-deserving groups.",
        "fr": "Le leadership de l'organisme à vocation sociale inclut des personnes issues de groupes méritant l'équité ayant l'expérience vécue."
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome2"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator6",
      "@type": "cids:Indicator",
      "hasName": "Is your leadership* (i.e. founder, owner, and/or senior management) composed of women or/and gender-diverse people?",
      "label": {
        "en": "Is your leadership* (i.e. founder, owner, and/or senior management) composed of women or/and gender-diverse people?",
        "fr": "Votre leadership* (c'est-à-dire le fondateur, le propriétaire et/ou les cadres supérieurs)  est-il composé de femmes ou/et de personnes de diverses identités de genre ?"
      },
      "hasDescription": "Leadership of the social purpose organization includes lived experience from women and/or gender diverse people.",
      "comment": {
        "en": "Leadership of the social purpose organization includes lived experience from women and/or gender diverse people.",
        "fr": "Le leadership de l'organisme à vocation sociale inclut des femmes ou/et des personnes de diverses identités de genre ayant l'expérience vécue."
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome2"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator7",
      "@type": "cids:Indicator",
      "hasName": "Do you provide formal or/and informal ways for your clients/customers to inform your product design, decision making, etc.?",
      "label": {
        "en": "Do you provide formal or/and informal ways for your clients/customers to inform your product design, decision making, etc.?",
        "fr": "Offrez-vous à vos clients des moyens formels ou/et informels d'influencer la conception de vos produits, la prise de décision etc. ?"
      },
      "hasDescription": "Leadership of the social purpose organization is informed by participatory processes from the lived experience of target clients/customers from equity-deserving groups.",
      "comment": {
        "en": "Leadership of the social purpose organization is informed by participatory processes from the lived experience of target clients/customers from equity-deserving groups.",
        "fr": "Le leadership de l'organisme à vocation sociale met en place des processus participatifs pour tenir compte de l'expérience vécue des clients ciblés provenant des groupes méritant l'équité."
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome2"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator8",
      "@type": "cids:Indicator",
      "hasName": "Have you built meaningful social equity practices within your internal organizational culture? (Assessed only for social purpose organizations in operation for over 2 years and employing 5 full-time staff or more.)",
      "label": {
        "en": "Have you built meaningful social equity practices within your internal organizational culture? (Assessed only for social purpose organizations in operation for over 2 years and employing 5 full-time staff or more.)",
        "fr": "Avez-vous mis en place des pratiques d'équité sociale significatives au sein de votre culture organisationnelle ? Vise les organismes à vocation sociale opérationnels depuis plus de 2 ans et embauchant 5 employés à temps plein ou plus."
      },
      "hasDescription": "The social purpose organization meaningfully integrates social equity practices in its internal organizational culture. Assessed only for social purpose organizations in operation for over 2 years and employing 5 full-time staff or more.",
      "comment": {
        "en": "The social purpose organization meaningfully integrates social equity practices in its internal organizational culture. Assessed only for social purpose organizations in operation for over 2 years and employing 5 full-time staff or more.",
        "fr": "L'organisme à vocation sociale intègre activement des pratiques d'équité sociale dans sa culture organisationnelle. Vise les organismes à vocation sociale opérationnels depuis plus de 2 ans et embauchant 5 employés à temps plein ou plus."
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome3"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator9",
      "@type": "cids:Indicator",
      "hasName": "How do you advance Indigenous Reconciliation within your work? (Not for assessment as part of SELI/GLI Thresholds)",
      "label": {
        "en": "How do you advance Indigenous Reconciliation within your work? (Not for assessment as part of SELI/GLI Thresholds)",
        "fr": "Comment votre organisation fait-elle progresser la Réconciliation avec les Peuples Autochtones dans le cadre de son travail ? (Non évalué dans le cadre des seuils de l'IOES et de l'IOG)"
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome4"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator10",
      "@type": "cids:Indicator",
      "hasName": "Social Equity Lens Investment Assessment",
      "label": {
          "en": "Social Equity Lens Investment Assessment",
          "fr": "Évaluation de l'investissement dans une Optique d'Équité Sociale"
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome5"
    },
    {
      "@id": "https://codelist.commonapproach.org/codeLists/SELI/Indicator11",
      "@type": "cids:Indicator",
      "hasName": "Gender Lens Investment Assessment",
      "label": {
          "en": "Gender Lens Investment Assessment",
          "fr": "Évaluation de l'Investissement dans une Optique de Genre"
      },
      "forOutcome": "https://codelist.commonapproach.org/codeLists/SELI/Outcome5"
    }
  ]
}
