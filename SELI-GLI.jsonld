            "org:hasName": "Have you built meaningful social equity practices within your internal organizational culture? (Assessed only for social purpose organizations in operation for over 2 years and employing 5 full-time staff or more.)",
            "skos:prefLabel": [
                {
                    "@language": "en",
                    "@value": "Have you built meaningful social equity practices within your internal organizational culture? (Assessed only for social purpose organizations in operation for over 2 years and employing 5 full-time staff or more.)"
                },
                {
                    "@language": "fr",
                    "@value": "Avez-vous mis en place des pratiques d'équité sociale significatives au sein de votre culture organisationnelle ? Vise les organismes à vocation sociale opérationnels depuis plus de 2 ans et embauchant 5 employés à temps plein ou plus."
                }
            ],
