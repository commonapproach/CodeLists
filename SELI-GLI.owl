    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <org:hasName>Are your products/services designed to support equity-deserving groups, and promote social equity?</org:hasName>
    <skos:prefLabel xml:lang="en">Are your products/services designed to support equity-deserving groups, and promote social equity?</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Vos produits/services sont-ils conçus pour soutenir les groupes méritant l'équité et promouvoir l'équité sociale ?</skos:prefLabel>
    <rdfs:label xml:lang="en">Are your products/services designed to support equity-deserving groups, and promote social equity?</rdfs:label>
    <rdfs:label xml:lang="fr">Vos produits/services sont-ils conçus pour soutenir les groupes méritant l'équité et promouvoir l'équité sociale ?</rdfs:label>
    <cids:hasDescription>Products or/and services are designed by the social purpose organization to target initiatives advancing social equity and the well-being of equity-deserving groups.</cids:hasDescription>
    <skos:definition xml:lang="en">Products or/and services are designed by the social purpose organization to target initiatives advancing social equity and the well-being of equity-deserving groups.</skos:definition>
    <skos:definition xml:lang="fr">Les produits et/ou services sont conçus par l'organisme à vocation sociale de manière à cibler des initiatives visant à promouvoir l'équité sociale et le bien-être des groupes méritant l'équité.</skos:definition>
    <rdfs:comment xml:lang="en">Products or/and services are designed by the social purpose organization to target initiatives advancing social equity and the well-being of equity-deserving groups.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Les produits et/ou services sont conçus par l'organisme à vocation sociale de manière à cibler des initiatives visant à promouvoir l'équité sociale et le bien-être des groupes méritant l'équité.</rdfs:comment>
    <cids:forOutcome rdf:resource="#Outcome1"/>
    <cids:forOrganization rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <cids:hasSpecification rdf:resource=""/>
  </rdf:Description>
  <rdf:Description rdf:about="#Indicator3">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#Indicator"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <org:hasName>Do you integrate a social equity analysis while developing your prodcts/services?</org:hasName>
    <skos:prefLabel xml:lang="en">Do you integrate a social equity analysis while developing your prodcts/services?</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Intégrez-vous une analyse d'équité sociale lors du développement de vos produits et/ou services?</skos:prefLabel>
    <rdfs:label xml:lang="en">Do you integrate a social equity analysis while developing your prodcts/services?</rdfs:label>
    <rdfs:label xml:lang="fr">Intégrez-vous une analyse d'équité sociale lors du développement de vos produits et/ou services?</rdfs:label>
    <cids:hasDescription>The social purpose organization conducts a social equity analysis in the development of their products or/and services, and integrates mitigation strategies as applicable.</cids:hasDescription>
    <skos:definition xml:lang="en">The social purpose organization conducts a social equity analysis in the development of their products or/and services, and integrates mitigation strategies as applicable.</skos:definition>
    <skos:definition xml:lang="fr">L'organisme à vocation sociale effectue une analyse d'équité sociale dans le cadre du développement de ses produits et/ou services, et intègre des stratégies d'atténuation le cas échéant.</skos:definition>
    <rdfs:comment xml:lang="en">The social purpose organization conducts a social equity analysis in the development of their products or/and services, and integrates mitigation strategies as applicable.</rdfs:comment>
    <rdfs:comment xml:lang="fr">L'organisme à vocation sociale effectue une analyse d'équité sociale dans le cadre du développement de ses produits et/ou services, et intègre des stratégies d'atténuation le cas échéant.</rdfs:comment>
    <cids:forOutcome rdf:resource="#Outcome1"/>
    <cids:forOrganization rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <cids:hasSpecification rdf:resource=""/>
  </rdf:Description>
  <rdf:Description rdf:about="#Indicator2">
