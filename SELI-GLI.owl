    <org:hasName>Are your products/services designed to support women or/and gender-diverse people, and promote gender equality?</org:hasName>
    <skos:prefLabel xml:lang="en">Are your products/services designed to support women or/and gender-diverse people, and promote gender equality?</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Vos produits/services sont-ils conçus pour soutenir les femmes et/ou les  personnes de diverses identités de genre, et faire avancer l'égalité des genres?</skos:prefLabel>
    <rdfs:label xml:lang="en">Are your products/services designed to support women or/and gender-diverse people, and promote gender equality?</rdfs:label>
    <rdfs:label xml:lang="fr">Vos produits/services sont-ils conçus pour soutenir les femmes et/ou les  personnes de diverses identités de genre, et faire avancer l'égalité des genres?</rdfs:label>
    <cids:hasDescription>Products or/and services are designed by the social purpose organization to target initiatives advancing gender equality and the well-being of women and gender diverse people.</cids:hasDescription>
    <skos:definition xml:lang="en">Products or/and services are designed by the social purpose organization to target initiatives advancing gender equality and the well-being of women and gender diverse people.</skos:definition>
    <skos:definition xml:lang="fr">Les produits et/ou services sont conçus par l'intermédiaire de finance sociale de manière à cibler des initiatives visant à promouvoir l'égalité des genres et l'équité des femmes et des personnes de diverses identités de genre.</skos:definition>
    <rdfs:comment xml:lang="en">Products or/and services are designed by the social purpose organization to target initiatives advancing gender equality and the well-being of women and gender diverse people.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Les produits et/ou services sont conçus par l'intermédiaire de finance sociale de manière à cibler des initiatives visant à promouvoir l'égalité des genres et l'équité des femmes et des personnes de diverses identités de genre.</rdfs:comment>
    <cids:forOutcome rdf:resource="#Outcome1"/>
    <cids:forOrganization rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <cids:hasSpecification rdf:resource=""/>
  </rdf:Description>
