  <rdf:Description rdf:about="#ps26">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps26</skos:notation>
    <org:hasIdentifier>ps26</org:hasIdentifier>
    <skos:definition xml:lang="en">In Canada, individuals who self-identify as Indigenous (First Nations, Inuit, or Métis) but do not specify their group affiliation, are unsure of their specific ancestry, or identify with another Indigenous community not listed separately.</skos:definition>
    <cids:hasDescription xml:lang="en">In Canada, individuals who self-identify as Indigenous (First Nations, Inuit, or Métis) but do not specify their group affiliation, are unsure of their specific ancestry, or identify with another Indigenous community not listed separately.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Indigenous Peoples: Not Otherwise Specified</skos:prefLabel>
    <org:hasName>Indigenous Peoples: Not Otherwise Specified</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
