    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps22</skos:notation>
    <org:hasIdentifier>ps22</org:hasIdentifier>
    <skos:definition xml:lang="en">All people who identify as women, whether they are cisgender or transgender women.</skos:definition>
    <cids:hasDescription>All people who identify as women, whether they are cisgender or transgender women.</cids:hasDescription>
