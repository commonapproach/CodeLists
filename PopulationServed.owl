  <rdf:Description rdf:about="#ps21">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps21</skos:notation>
    <org:hasIdentifier>ps21</org:hasIdentifier>
    <skos:definition xml:lang="en">People who identify as being survivors of domestic violence, including intimate partner violence, sexual assault, stalking and/or harassment.</skos:definition>
    <cids:hasDescription>People who identify as being survivors of domestic violence, including intimate partner violence, sexual assault, stalking and/or harassment.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Survivors of Domestic Violence, Sexual assault, Abuse or Stalking</skos:prefLabel>
    <org:hasName>Survivors of Domestic Violence, Sexual assault, Abuse or Stalking</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps9">
    <skos:exactMatch rdf:resource="EquityDeservingGroupsESDC#edg8"/>
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps9</skos:notation>
    <org:hasIdentifier>ps9</org:hasIdentifier>
    <skos:definition xml:lang="en">People other than Indigenous peoples or Black Canadians who are non-Caucasian in race or non-white in colour (refer to the Statistics Canada definition for “visible minorities”).</skos:definition>
    <cids:hasDescription>People other than Indigenous peoples or Black Canadians who are non-Caucasian in race or non-white in colour (refer to the Statistics Canada definition for “visible minorities”).</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Other Racialized Peoples</skos:prefLabel>
    <org:hasName>Other Racialized Peoples</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps20">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps20</skos:notation>
    <org:hasIdentifier>ps20</org:hasIdentifier>
    <skos:definition xml:lang="en">People that have not completed any university, college or other post-secondary qualification.</skos:definition>
    <cids:hasDescription>People that have not completed any university, college or other post-secondary qualification.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">People without Advanced Educational Qualification</skos:prefLabel>
    <org:hasName>People without Advanced Educational Qualification</org:hasName>
