    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.canada.ca/en/women-gender-equality/free-to-be-me/2slgbtqi-plus-glossary.html"/>
    <skos:notation>ps1</skos:notation>
    <org:hasIdentifier>ps1</org:hasIdentifier>
    <skos:definition xml:lang="en">People who identify as being two-spirit, lesbian, gay, bisexual, transgender, queer, intersex, asexual and others (“+”).</skos:definition>
    <cids:hasDescription>People who identify as being two-spirit, lesbian, gay, bisexual, transgender, queer, intersex, asexual and others (“+”).</cids:hasDescription>
    <skos:prefLabel xml:lang="en">2SLGBTQIA+</skos:prefLabel>
    <org:hasName>2SLGBTQIA+</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps17">
    <skos:broadMatch rdf:resource="EquityDeservingGroupsESDC#edg9"/>
    <skos:broader rdf:resource="#ps27"/>
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://laws-lois.justice.gc.ca/eng/acts/A-0.6/"/>
    <skos:notation>ps17</skos:notation>
    <org:hasIdentifier>ps17</org:hasIdentifier>
    <skos:definition xml:lang="en">People living with disabilities, impairments, and/or functional limitations related to physical, sensory, or pain, whether apparent or not, and permanent, temporary or episodic in nature, that hinders their full and equal participation in society when they face a barrier.</skos:definition>
    <cids:hasDescription>People living with disabilities, impairments, and/or functional limitations related to physical, sensory, or pain, whether apparent or not, and permanent, temporary or episodic in nature, that hinders their full and equal participation in society when they face a barrier.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">People Living with Physical,Sensory or Pain Related Disabilities</skos:prefLabel>
    <org:hasName>People Living with Physical,Sensory or Pain Related Disabilities</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps12">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps12</skos:notation>
    <org:hasIdentifier>ps12</org:hasIdentifier>
    <skos:definition xml:lang="en">Communities located, and people living, in Northern Canada, which is defined as: The three Canadian territories (Yukon, Northwest Territories, and Nunavut), and the northern extent of Newfoundland and Labrador, Quebec, Ontario, Manitoba, Saskatchewan, Alberta and British Columbia. North is based on provincially determined definitions that generally reflect administrative regions.</skos:definition>
    <cids:hasDescription>Communities located, and people living, in Northern Canada, which is defined as: The three Canadian territories (Yukon, Northwest Territories, and Nunavut), and the northern extent of Newfoundland and Labrador, Quebec, Ontario, Manitoba, Saskatchewan, Alberta and British Columbia. North is based on provincially determined definitions that generally reflect administrative regions.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Northern Canadian Communities</skos:prefLabel>
    <org:hasName>Northern Canadian Communities</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps11">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps11</skos:notation>
    <org:hasIdentifier>ps11</org:hasIdentifier>
    <skos:definition xml:lang="en">Families or homes where there is one parent present or living there. The lone, or single, parent can be any sex or gender, any ethnicity, and any sexuality. They do not have to be blood-related parents either to be classed as a parent.</skos:definition>
    <cids:hasDescription>Families or homes where there is one parent present or living there. The lone, or single, parent can be any sex or gender, any ethnicity, and any sexuality. They do not have to be blood-related parents either to be classed as a parent.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Lone Parent Families</skos:prefLabel>
    <org:hasName>Lone Parent Families</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps14">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.homelesshub.ca/sites/default/files/COHhomelessdefinition.pdf"/>
    <skos:notation>ps14</skos:notation>
    <org:hasIdentifier>ps14</org:hasIdentifier>
    <skos:definition xml:lang="en">People without stable, safe, permanent, appropriate housing, or the immediate prospect, means, and ability of acquiring it.</skos:definition>
    <cids:hasDescription>People without stable, safe, permanent, appropriate housing, or the immediate prospect, means, and ability of acquiring it.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">People Experiencing Homelessness or Housing Insecurities</skos:prefLabel>
    <org:hasName>People Experiencing Homelessness or Housing Insecurities</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps13">
    <skos:exactMatch rdf:resource="EquityDeservingGroupsESDC#edg7"/>
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps13</skos:notation>
    <org:hasIdentifier>ps13</org:hasIdentifier>
    <skos:definition xml:lang="en">In Canada, official-language minority communities are mainly French-speaking people living outside the province of Quebec and English-speaking people living in the province of Quebec.</skos:definition>
    <cids:hasDescription>In Canada, official-language minority communities are mainly French-speaking people living outside the province of Quebec and English-speaking people living in the province of Quebec.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Official Languages Minority Communities</skos:prefLabel>
    <org:hasName>Official Languages Minority Communities</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
