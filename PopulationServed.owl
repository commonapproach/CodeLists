  <rdf:Description rdf:about="#ps10">
    <skos:exactMatch rdf:resource="EquityDeservingGroupsESDC#edg3"/>
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>ps10</skos:notation>
    <org:hasIdentifier>ps10</org:hasIdentifier>
    <skos:definition xml:lang="en">People who were born outside Canada. For the most part, these are people who are now, or once were, immigrants to Canada. People who were forced to flee from persecution in their home country. This includes Convention refugees (as defined by the Immigration and Refugee Protection Act (S.C. 2001, c. 27)) and asylum-seekers or refugee claimants. Immigrants and Refugees that have been in Canada for less than five years.</skos:definition>
    <cids:hasDescription>People who were born outside Canada. For the most part, these are people who are now, or once were, immigrants to Canada. People who were forced to flee from persecution in their home country. This includes Convention refugees (as defined by the Immigration and Refugee Protection Act (S.C. 2001, c. 27)) and asylum-seekers or refugee claimants. Immigrants and Refugees that have been in Canada for less than five years.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">First Generation Immigrants, Refugees &amp; Newcomers</skos:prefLabel>
    <org:hasName>First Generation Immigrants, Refugees &amp; Newcomers</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps16">
    <skos:broadMatch rdf:resource="EquityDeservingGroupsESDC#edg9"/>
    <skos:broader rdf:resource="#ps27"/>
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://laws-lois.justice.gc.ca/eng/acts/A-0.6/"/>
    <skos:notation>ps16</skos:notation>
    <org:hasIdentifier>ps16</org:hasIdentifier>
    <skos:definition xml:lang="en">People living with disabilities, impairments, and/or functional limitations related to cognitive, learning, communication or mental health related issues, whether apparent or not, and permanent, temporary or episodic in nature, that hinders their full and equal participation in society when they face a barrier.</skos:definition>
    <cids:hasDescription>People living with disabilities, impairments, and/or functional limitations related to cognitive, learning, communication or mental health related issues, whether apparent or not, and permanent, temporary or episodic in nature, that hinders their full and equal participation in society when they face a barrier.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">People Living with Cognitive or Mental Health Related Issues</skos:prefLabel>
    <org:hasName>People Living with Cognitive or Mental Health Related Issues</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps3">
    <skos:exactMatch rdf:resource="EquityDeservingGroupsESDC#edg11"/>
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.canada.ca/en/women-gender-equality/free-to-be-me/2slgbtqi-plus-glossary.html"/>
    <skos:notation>ps3</skos:notation>
    <org:hasIdentifier>ps3</org:hasIdentifier>
    <skos:definition xml:lang="en">People whose gender identity does not align with a binary understanding of gender such as man or woman. It is a gender identity which may include man and woman, androgynous, fluid, multiple, no gender, or a different gender outside of the “woman—man” spectrum.</skos:definition>
    <cids:hasDescription>People whose gender identity does not align with a binary understanding of gender such as man or woman. It is a gender identity which may include man and woman, androgynous, fluid, multiple, no gender, or a different gender outside of the “woman—man” spectrum.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Gender Diverse People: Non-Binary</skos:prefLabel>
    <org:hasName>Gender Diverse People: Non-Binary</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
  <rdf:Description rdf:about="#ps15">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.canada.ca/en/employment-social-development/programs/poverty-reduction/backgrounder.html"/>
    <skos:notation>ps15</skos:notation>
    <org:hasIdentifier>ps15</org:hasIdentifier>
    <skos:definition xml:lang="en">People living on low income as defined by any of several relative indicators/thresholds used by the Government of Canada to measure low income: low income cut-offs (LICOs), market basket measure (MBM), and/or low income measure (LIM).</skos:definition>
    <cids:hasDescription>People living on low income as defined by any of several relative indicators/thresholds used by the Government of Canada to measure low income: low income cut-offs (LICOs), market basket measure (MBM), and/or low income measure (LIM).</cids:hasDescription>
    <skos:prefLabel xml:lang="en">People Living on Low Income</skos:prefLabel>
    <org:hasName>People Living on Low Income</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
  </rdf:Description>
