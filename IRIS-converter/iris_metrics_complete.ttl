@prefix cat: <https://iris.thegiin.org/category/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iris: <https://iris.thegiin.org/metric/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix theme: <https://iris.thegiin.org/theme/> .

cat:financial-impact a skos:Concept ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:prefLabel "Financial Impact"@en .

cat:operational-description a skos:Concept ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:prefLabel "Operational Description"@en .

cat:organizational-descriptor a skos:Concept ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:prefLabel "Organizational Descriptor"@en .

cat:pi9467 a skos:Concept ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:prefLabel "PI9467"@en .

cat:product-descriptor a skos:Concept ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:prefLabel "Product Descriptor"@en .

iris:FP1001 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of expenditures incurred by the organization as a result of performing its normal business operations during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1001" ;
    skos:prefLabel "Operating Expenses"@en .

iris:FP1012 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of expenditures incurred by the organization during the reporting period as a result of interest incurred on all liabilities, including any client deposit accounts held by the organization, borrowings, and subordinated debt."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1012" ;
    skos:prefLabel "Interest Expenses"@en .

iris:FP1129 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:financial-services,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Net value of the organization's loans receivable as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1129" ;
    skos:prefLabel "Loans Receivable Net"@en .

iris:FP1192 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Ratio between the organization's loans receivable gross and its total deposits as of the end of the reporting period, used to assess an organization's liquidity."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1192" ;
    skos:prefLabel "Loan to Deposit (LTD) Ratio"@en .

iris:FP1301 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of the organization's net profit, calculated as total income minus total expenses, taxes, and cost of goods sold during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1301" ;
    skos:prefLabel "Net Income"@en .

iris:FP1307 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of capital available to the organization for lending and investing as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1307" ;
    skos:prefLabel "Capital Available: Total"@en .

iris:FP1657 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition """Value of the organization's net income before interest, taxes, depreciation, and amortization during the reporting period.

EBITDA signifies Earnings Before Interest, Taxes, Depreciation, and Amortization."""@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1657" ;
    skos:prefLabel "EBITDA"@en .

iris:FP1717 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of assets classified as impaired under regulatory or accounting rules and recorded by the organization during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1717" ;
    skos:prefLabel "Impaired Assets"@en .

iris:FP1996 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value of the organization’s liabilities as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP1996" ;
    skos:prefLabel "Total Liabilities"@en .

iris:FP2213 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value, as of the end of the reporting period, of the organization’s outstanding debts from clients who received goods or services on credit."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2213" ;
    skos:prefLabel "Accounts Receivable"@en .

iris:FP2269 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value, as of the end of the reporting period, of all liabilities that are expected to be settled within one year in the normal course of business."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2269" ;
    skos:prefLabel "Current Liabilities"@en .

iris:FP2321 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of all expenditures incurred by the organization during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2321" ;
    skos:prefLabel "Total Expenses"@en .

iris:FP2392 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:financial-services,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of the organization’s contra asset account set up as a provision for a potential future loss of capital that has been lent out by the organization as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2392" ;
    skos:prefLabel "Impairment Loss Allowance"@en .

iris:FP2460 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:financial-services,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of the organization’s gross incurred claims as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2460" ;
    skos:prefLabel "Gross Incurred Claims"@en .

iris:FP2553 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:income-statement,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of expenditures incurred by the organization during the reporting period to settle interest, fees, and commissions incurred on the organization’s financial liabilities—including, among others, any client deposit accounts held by the organization, borrowings, and subordinated debt."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2553" ;
    skos:prefLabel "Financial Expenses"@en .

iris:FP2630 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:financial-services,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of outstanding principal for all of the organization’s outstanding loans due from clients as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2630" ;
    skos:prefLabel "Loans Receivable Gross"@en .

iris:FP2635 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:employment,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of the organization’s loans outstanding, as of the end of the reporting period, with one or more installments of principal past due for more than 30 days."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2635" ;
    skos:prefLabel "Non-Performing Loans (Portfolio at Risk): 30 Days"@en .

iris:FP2638 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of capital available to the organization for lending and investing as of the end of the reporting period that is attributed to debt obligations on the organization’s balance sheet."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2638" ;
    skos:prefLabel "Capital Available: Borrowed Funds"@en .

iris:FP2651 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition """Value of an organization’s net profit generated per dollar of shareholders’ equity during the reporting period.

This is a profitability ratio calculated as net income divided by average total equity or net assets."""@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2651" ;
    skos:prefLabel "Return on Equity (ROE)"@en .

iris:FP2852 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value, as of the end of the reporting period, of all outstanding debts that must be paid by the organization within a given period of time in order to avoid default."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP2852" ;
    skos:prefLabel "Accounts Payable"@en .

iris:FP3021 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of revenue contributed as grants and donations during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP3021" ;
    skos:prefLabel "Revenue from Grants and Donations"@en .

iris:FP3274 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of the organization's net profit before donations, calculated as total income (excluding donations) minus total expenses during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP3274" ;
    skos:prefLabel "Net Income Before Donations"@en .

iris:FP3297 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Percentage growth in the value of the organization’s net income from one reporting period to another."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP3297" ;
    skos:prefLabel "Income Growth"@en .

iris:FP3466 a skos:Concept ;
    skos:broader cat:cash-flow,
        cat:cross-category ;
    skos:definition "Value of the organization’s net cash flow during the reporting period. Net cash flow equals inflows less outflows of cash and cash equivalents from operating, investing, financing, and other activities."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP3466" ;
    skos:prefLabel "Cash Flow: Net Total"@en .

iris:FP3673 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition """Value of the organization's net income before interest and taxes during the reporting period.

EBIT signifies Earnings Before Interest and Taxes."""@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP3673" ;
    skos:prefLabel "EBIT"@en .

iris:FP3774 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Value of all financial contributions and in-kind donations of goods and services made by the organization to charities, private foundations, non-profit organizations, or non-governmental organizations during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP3774" ;
    skos:prefLabel "Charitable Donations"@en .

iris:FP3939 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:income-statement,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of loans collected by the organization during the reporting period that had previously been written off."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP3939" ;
    skos:prefLabel "Loans Recovered"@en .

iris:FP4224 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Ratio of the organization’s current assets compared to current liabilities as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP4224" ;
    skos:prefLabel "Working Capital Ratio"@en .

iris:FP4326 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition """Value of an organization’s net profit after taxes generated per dollar invested in total assets as of the end of the reporting period.

This is a profitability ratio calculated as net income less taxes, divided by average total assets."""@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP4326" ;
    skos:prefLabel "Return on Assets (ROA)"@en .

iris:FP4373 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Percentage of revenue that the organization retains after incurring the direct costs associated with the production/delivery of its products/services during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP4373" ;
    skos:prefLabel "Gross Margin"@en .

iris:FP4649 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value, as of the end of the reporting period, of the organization's non-physical assets such as cash, bank accounts, or other investments."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP4649" ;
    skos:prefLabel "Financial Assets"@en .

iris:FP4761 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Percentage growth in value of the organization's revenue from one reporting period to another."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP4761" ;
    skos:prefLabel "Revenue Growth"@en .

iris:FP4812 a skos:Concept ;
    skos:broader cat:cash-flow,
        cat:cross-category ;
    skos:definition "Value of the organization's cash flow during the reporting period related to operating activities."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP4812" ;
    skos:prefLabel "Cash Flow: Operating Activities"@en .

iris:FP4831 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of expenditures related to personnel, including wages, benefits, trainings, and payroll taxes, incurred by the organization during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP4831" ;
    skos:prefLabel "Personnel Expenses"@en .

iris:FP4849 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of revenue derived from activities not related to the organization's core operations during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP4849" ;
    skos:prefLabel "Non-operating Revenue"@en .

iris:FP5261 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of all transfers to governments made by the organization during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP5261" ;
    skos:prefLabel "Payments to Government"@en .

iris:FP5293 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value, as of the end of the reporting period, of all of the organization's assets."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP5293" ;
    skos:prefLabel "Total Assets"@en .

iris:FP5317 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value of the residual interest, as of the end of the reporting period, in the assets of the organization after deducting all its liabilities."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP5317" ;
    skos:prefLabel "Equity or Net Assets"@en .

iris:FP5624 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of revenue during the reporting period from sales of the organization’s products/services and collected from third-party (public or private) payers."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP5624" ;
    skos:prefLabel "Sales Revenue: Collected from Third Party Payers"@en .

iris:FP5662 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of capital available to the organization for lending and investing at the end of the reporting period that is attributed to equity contributions."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP5662" ;
    skos:prefLabel "Capital Available: Equity Capital"@en .

iris:FP5979 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:employment,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Number of the organization’s loans due for complete payback during the reporting period (but disbursed at any time) that were repaid no later than their due dates."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP5979" ;
    skos:prefLabel "Number of Loans Fully Repaid on Time"@en .

iris:FP6094 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value, as of the end of the reporting period, of an organization's long-term financial liabilities."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6094" ;
    skos:prefLabel "Long Term Financial Liabilities"@en .

iris:FP6152 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Ratio of an organization’s admitted assets to liabilities, per their statutory accounts, as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6152" ;
    skos:prefLabel "Solvency Ratio"@en .

iris:FP6354 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:employment,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of the organization’s loans outstanding, as of the end of the reporting period, with one or more installments of principal past due for more than 60 days."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6354" ;
    skos:prefLabel "Non-Performing Loans (Portfolio at Risk): 60 Days"@en .

iris:FP6373 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:employment,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of the organization’s loans outstanding, as of the end of the reporting period, with one or more installments of principal past due for more than 90 days."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6373" ;
    skos:prefLabel "Non-Performing Loans (Portfolio at Risk): 90 Days"@en .

iris:FP6462 a skos:Concept ;
    skos:broader cat:cash-flow,
        cat:cross-category ;
    skos:definition "Value of the organization's cash equivalents as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6462" ;
    skos:prefLabel "Cash and Cash Equivalents: Period End"@en .

iris:FP6510 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of all revenue received by the organization during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6510" ;
    skos:prefLabel "Total Revenue"@en .

iris:FP6750 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value of the remaining balance, as of the end of the reporting period, on all the organization's outstanding debt obligations carried on the balance sheet."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6750" ;
    skos:prefLabel "Loans Payable"@en .

iris:FP6856 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Value of the organization's operating liquidity as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6856" ;
    skos:prefLabel "Working Capital"@en .

iris:FP6926 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value, as of the end of the reporting period, of the organization's assets that the organization reasonably expects to convert into cash within one year in the normal course of business."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP6926" ;
    skos:prefLabel "Current Assets"@en .

iris:FP7264 a skos:Concept ;
    skos:broader cat:cash-flow,
        cat:cross-category ;
    skos:definition "Value of the organization's cash equivalents as of the beginning of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP7264" ;
    skos:prefLabel "Cash and Cash Equivalents: Period Start"@en .

iris:FP7629 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of the organization's residual profit after incurring the direct costs associated with the production/delivery of products/services during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP7629" ;
    skos:prefLabel "Gross Profit"@en .

iris:FP7897 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Percentage of the organization's revenue that remains after paying variable costs such as wages and raw materials during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP7897" ;
    skos:prefLabel "Operating Profit Margin"@en .

iris:FP8244 a skos:Concept ;
    skos:broader cat:cash-flow,
        cat:cross-category ;
    skos:definition "Value of the organization's cash flow during the reporting period related to its financing activities."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP8244" ;
    skos:prefLabel "Cash Flow: Financing Activities"@en .

iris:FP8293 a skos:Concept ;
    skos:broader cat:cash-flow,
        cat:cross-category ;
    skos:definition "Value of funds invested in the organization (both loans and investments) during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP8293" ;
    skos:prefLabel "New Investment Capital"@en .

iris:FP8295 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Ratio of the organization's personnel expenses compared to its loans receivable as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP8295" ;
    skos:prefLabel "Personnel Efficiency"@en .

iris:FP8300 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition "Value of revenue during the reporting period from sales of the organization’s products/services and collected directly from clients."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP8300" ;
    skos:prefLabel "Sales Revenue: Collected Directly"@en .

iris:FP8478 a skos:Concept ;
    skos:broader cat:financial-services,
        cat:ratios-concepts-and-calculations,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Percentage of gross incurred claims during the reporting period relative to gross earned premiums during the same reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP8478" ;
    skos:prefLabel "Incurred Claims Ratio"@en .

iris:FP8569 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:ratios-concepts-and-calculations ;
    skos:definition "Ratio of the organization's operating expenses compared to its loans receivable as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP8569" ;
    skos:prefLabel "Operating Efficiency"@en .

iris:FP8653 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value of the sum of the organization's profits, cumulative from inception to the end of the reporting period, not paid out as dividends but retained by the organization for reinvestment in its core business or to pay down debt."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP8653" ;
    skos:prefLabel "Retained Earnings"@en .

iris:FP9049 a skos:Concept ;
    skos:broader cat:cross-category,
        cat:income-statement ;
    skos:definition """This metric is intended to capture the organization’s operating efficiency.
Value of direct expenditures attributable to the production of goods sold by the organization during the reporting period."""@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP9049" ;
    skos:prefLabel "Cost of Goods Sold"@en .

iris:FP9083 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:financial-services,
        theme:employment,
        theme:financial-inclusion,
        theme:financial-services ;
    skos:definition "Value of the organization’s customer deposits, whether voluntary, compulsory, demand, or term, as well as all other liabilities from customers as of the end of the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP9083" ;
    skos:prefLabel "Total Deposits"@en .

iris:FP9148 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value, as of the end of the reporting period, of the organization's long-term tangible assets that the organization does not expect to convert into cash in the current or upcoming fiscal year."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP9148" ;
    skos:prefLabel "Fixed Assets"@en .

iris:FP9462 a skos:Concept ;
