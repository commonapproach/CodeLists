        cat:income-statement ;
    skos:definition "Value of expenses recorded by the organization during the reporting period for depreciation and amortization."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP9462" ;
    skos:prefLabel "Depreciation and Amortization Expenses"@en .

iris:FP9573 a skos:Concept ;
    skos:broader cat:balance-sheet,
        cat:cross-category ;
    skos:definition "Value of funds used by a company to acquire, upgrade, and maintain physical assets such as property, plants, buildings, technology, or equipment during the reporting period."@en ;
    skos:inScheme <https://iris.thegiin.org/taxonomy> ;
    skos:notation "FP9573" ;
    skos:prefLabel "Capital Expenditure (CapEx)"@en .

iris:FP9649 a skos:Concept ;
