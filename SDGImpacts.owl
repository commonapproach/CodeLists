  <rdf:Description rdf:about="https://metadata.un.org/sdg">
    <dcterms:title xml:lang="en">Sustainable Development Goals Taxonomy</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="">
    <dcterms:description xml:lang="en">A mirror of the official UN Sustainable Development Goals (SDGs) Taxonomy. This vocabulary uses the UN's official IRIs as the primary identifiers for each goal. It retains the original commonapproach.org IRIs, which are now marked as deprecated, for backward compatibility.</dcterms:description>
    <dcterms:title xml:lang="en">Sustainable Development Goals Impact Themes</dcterms:title>
    <skos:prefLabel xml:lang="en">Sustainable Development Goals Impact Themes</skos:prefLabel>
    <owl:versionInfo>2.0</owl:versionInfo>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-01</dcterms:date>
    <dcterms:creator rdf:resource="https://ontology.commonapproach.org/cids#ac"/>
    <owl:imports rdf:resource="https://ontology.commonapproach.org/cids"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
  </rdf:Description>
