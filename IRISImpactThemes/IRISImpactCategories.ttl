<https://codelist.commonapproach.org/codeLists/IRISImpactCategories>
    dcterms:creator cids:ac ;
    dcterms:date "21-08-2025" ;
    dcterms:description "An RDF vocabulary of IRIS+ Impact Categories."@en ;
    dcterms:title "IRIS+ Impact Categories"@en ;
    vann:preferredNamespacePrefix "IRISImpactCategories" ;
    vann:preferredNamespaceUri <https://codelist.commonapproach.org/codeLists/IRISImpactCategories#> ;
    a <http://purl.org/vocommons/voafVocabulary>, owl:Ontology ;
    rdfs:label "IRIS+ Impact Categories"@en ;
    owl:imports <http://www.w3.org/2006/time>, <https://ontology.commonapproach.org/cids> ;
    owl:versionInfo "1.0" ;
    foaf:name "IRIS+ Impact Categories"@en ;
    cids:hasName "IRIS+ Impact Categories"@en .

:dataset
    a skos:ConceptScheme .

