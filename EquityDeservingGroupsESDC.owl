<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:org="http://ontology.eil.utoronto.ca/tove/organization#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:prov="http://www.w3.org/ns/prov#"
    xmlns:cids="https://ontology.commonapproach.org/cids#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:voaf="http://purl.org/vocommons/voaf#"
    xmlns="https://codelist.commonapproach.org/EquityDeservingGroupsESDC#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#" > 
  <rdf:Description rdf:about="#edg10">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>edg10</skos:notation>
    <org:hasIdentifier>edg10</org:hasIdentifier>
    <skos:definition xml:lang="en">All people who identify as women, whether they are cisgender or transgender women.</skos:definition>
    <cids:hasDescription>All people who identify as women, whether they are cisgender or transgender women.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Women (Cisgender and Transgender)</skos:prefLabel>
    <org:hasName>Women (Cisgender and Transgender)</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg3">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>edg3</skos:notation>
    <org:hasIdentifier>edg3</org:hasIdentifier>
    <skos:definition xml:lang="en">People who were born outside Canada. For the most part, these are people who are now, or once were, immigrants to Canada. People who were forced to flee from persecution in their home country. This includes Convention refugees (as defined by the Immigration and Refugee Protection Act (S.C. 2001, c. 27)) and asylum-seekers or refugee claimants. Immigrants and Refugees that have been in Canada for less than five years.</skos:definition>
    <cids:hasDescription>People who were born outside Canada. For the most part, these are people who are now, or once were, immigrants to Canada. People who were forced to flee from persecution in their home country. This includes Convention refugees (as defined by the Immigration and Refugee Protection Act (S.C. 2001, c. 27)) and asylum-seekers or refugee claimants. Immigrants and Refugees that have been in Canada for less than five years.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">First Generation Immigrants, Refugees &amp; Newcomers</skos:prefLabel>
    <org:hasName>First Generation Immigrants, Refugees &amp; Newcomers</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg2">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.noslangues-ourlanguages.gc.ca/en/publications/equite-diversite-inclusion-equity-diversity-inclusion-eng#notion-69399"/>
    <skos:notation>edg2</skos:notation>
    <org:hasIdentifier>edg2</org:hasIdentifier>
    <skos:definition xml:lang="en">People belonging to any of various population groups of especially African ancestry often considered as having dark pigmentation of the skin but in fact having a wide range of skin colours.</skos:definition>
    <cids:hasDescription>People belonging to any of various population groups of especially African ancestry often considered as having dark pigmentation of the skin but in fact having a wide range of skin colours.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Black People</skos:prefLabel>
    <org:hasName>Black People</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg1">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.canada.ca/en/women-gender-equality/free-to-be-me/2slgbtqi-plus-glossary.html"/>
    <skos:notation>edg1</skos:notation>
    <org:hasIdentifier>edg1</org:hasIdentifier>
    <skos:definition xml:lang="en">People who identify as being two-spirit, lesbian, gay, bisexual, transgender, queer, intersex, asexual and others (“+”).</skos:definition>
    <cids:hasDescription>People who identify as being two-spirit, lesbian, gay, bisexual, transgender, queer, intersex, asexual and others (“+”).</cids:hasDescription>
    <skos:prefLabel xml:lang="en">2SLGBTQIA+</skos:prefLabel>
    <org:hasName>2SLGBTQIA+</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="">
    <dcterms:description xml:lang="en">A codelist vocabulary of Equity Deserving Groups as defined by Ministry of Employment and Social Development of Canada.</dcterms:description>
    <dcterms:title xml:lang="en">Equity Deserving Groups</dcterms:title>
    <skos:prefLabel xml:lang="en">Equity Deserving Groups</skos:prefLabel>
    <owl:versionInfo>2.0</owl:versionInfo>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-02</dcterms:date>
    <dcterms:creator rdf:resource="https://ontology.commonapproach.org/cids#ac"/>
    <owl:imports rdf:resource="https://ontology.commonapproach.org/cids"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg7">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>edg7</skos:notation>
    <org:hasIdentifier>edg7</org:hasIdentifier>
    <skos:definition xml:lang="en">In Canada, official-language minority communities are mainly French-speaking people living outside the province of Quebec and English-speaking people living in the province of Quebec.</skos:definition>
    <cids:hasDescription>In Canada, official-language minority communities are mainly French-speaking people living outside the province of Quebec and English-speaking people living in the province of Quebec.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Official Languages Minority Communities</skos:prefLabel>
    <org:hasName>Official Languages Minority Communities</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg6">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.noslangues-ourlanguages.gc.ca/en/publications/equite-diversite-inclusion-equity-diversity-inclusion-eng#notion-69399"/>
    <skos:notation>edg6</skos:notation>
    <org:hasIdentifier>edg6</org:hasIdentifier>
    <skos:definition xml:lang="en">In Canada, Indigenous People whose members are of mixed First Nations and European ancestry, are united by a common origin, history and culture, and are generally accepted by the Métis Nation.</skos:definition>
    <cids:hasDescription>In Canada, Indigenous People whose members are of mixed First Nations and European ancestry, are united by a common origin, history and culture, and are generally accepted by the Métis Nation.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Indigenous Peoples: Métis</skos:prefLabel>
    <org:hasName>Indigenous Peoples: Métis</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg5">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.noslangues-ourlanguages.gc.ca/en/publications/equite-diversite-inclusion-equity-diversity-inclusion-eng#notion-69399"/>
    <skos:notation>edg5</skos:notation>
    <org:hasIdentifier>edg5</org:hasIdentifier>
    <skos:definition xml:lang="en">In Canada, Indigenous People that inhabit or that traditionally inhabited the northern regions and Arctic coasts of Canada known as Inuit Nunangat, and whose members are united by a common origin, history and culture.</skos:definition>
    <cids:hasDescription>In Canada, Indigenous People that inhabit or that traditionally inhabited the northern regions and Arctic coasts of Canada known as Inuit Nunangat, and whose members are united by a common origin, history and culture.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Indigenous Peoples: Inuit</skos:prefLabel>
    <org:hasName>Indigenous Peoples: Inuit</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg4">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.noslangues-ourlanguages.gc.ca/en/publications/equite-diversite-inclusion-equity-diversity-inclusion-eng#notion-69399"/>
    <skos:notation>edg4</skos:notation>
    <org:hasIdentifier>edg4</org:hasIdentifier>
    <skos:definition xml:lang="en">In Canada, Indigenous people who are part of a First Nation or whose ancestors were part of a First Nation. A First Nation person can be a Status or Non-Status Indian.</skos:definition>
    <cids:hasDescription>In Canada, Indigenous people who are part of a First Nation or whose ancestors were part of a First Nation. A First Nation person can be a Status or Non-Status Indian.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Indigenous Peoples: First Nations</skos:prefLabel>
    <org:hasName>Indigenous Peoples: First Nations</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg13">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>edg13</skos:notation>
    <org:hasIdentifier>edg13</org:hasIdentifier>
    <skos:definition xml:lang="en">People whose gender identity does not align with any of the other options provided.</skos:definition>
    <cids:hasDescription>People whose gender identity does not align with any of the other options provided.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Gender Diverse People: Other</skos:prefLabel>
    <org:hasName>Gender Diverse People: Other</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg9">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>edg9</skos:notation>
    <org:hasIdentifier>edg9</org:hasIdentifier>
    <skos:prefLabel xml:lang="en">People Living with a Disability (including invisible and episodic disabilities)</skos:prefLabel>
    <org:hasName>People Living with a Disability (including invisible and episodic disabilities)</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg11">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://www.canada.ca/en/women-gender-equality/free-to-be-me/2slgbtqi-plus-glossary.html"/>
    <skos:notation>edg11</skos:notation>
    <org:hasIdentifier>edg11</org:hasIdentifier>
    <skos:definition xml:lang="en">People whose gender identity does not align with a binary understanding of gender such as man or woman. It is a gender identity which may include man and woman, androgynous, fluid, multiple, no gender, or a different gender outside of the “woman—man” spectrum.</skos:definition>
    <cids:hasDescription>People whose gender identity does not align with a binary understanding of gender such as man or woman. It is a gender identity which may include man and woman, androgynous, fluid, multiple, no gender, or a different gender outside of the “woman—man” spectrum.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Gender Diverse People: Non-Binary</skos:prefLabel>
    <org:hasName>Gender Diverse People: Non-Binary</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg8">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <skos:notation>edg8</skos:notation>
    <org:hasIdentifier>edg8</org:hasIdentifier>
    <skos:definition xml:lang="en">People other than Indigenous peoples or Black Canadians who are non-Caucasian in race or non-white in colour (refer to the Statistics Canada definition for “visible minorities”).</skos:definition>
    <cids:hasDescription>People other than Indigenous peoples or Black Canadians who are non-Caucasian in race or non-white in colour (refer to the Statistics Canada definition for “visible minorities”).</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Other Racialized Peoples</skos:prefLabel>
    <org:hasName>Other Racialized Peoples</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="#edg12">
    <skos:inScheme rdf:resource=""/>
    <rdfs:isDefinedBy rdf:resource=""/>
    <cids:hasSpecification rdf:resource=""/>
    <cids:definedBy rdf:resource="https://ontology.commonapproach.org/cids#esdc"/>
    <prov:hadPrimarySource rdf:resource="https://dictionary.cambridge.org/dictionary/english/agender"/>
    <skos:notation>edg12</skos:notation>
    <org:hasIdentifier>edg12</org:hasIdentifier>
    <skos:definition xml:lang="en">People who do not identify as, or with, any particular gender.</skos:definition>
    <cids:hasDescription>People who do not identify as, or with, any particular gender.</cids:hasDescription>
    <skos:prefLabel xml:lang="en">Gender Diverse People: Agender</skos:prefLabel>
    <org:hasName>Gender Diverse People: Agender</org:hasName>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#PopulationServed"/>
    <rdf:type rdf:resource="https://ontology.commonapproach.org/cids#EquityDeservingGroup"/>
  </rdf:Description>
</rdf:RDF>
