            "org:hasIdentifier": "edg10",
            "skos:definition": {
                "@language": "en",
                "@value": "All people who identify as women, whether they are cisgender or transgender women."
            },
            "cids:hasDescription": "All people who identify as women, whether they are cisgender or transgender women.",
            "skos:prefLabel": {
