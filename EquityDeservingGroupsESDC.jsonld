            "skos:notation": "edg2",
            "org:hasIdentifier": "edg2",
            "skos:definition": {
                "@language": "en",
                "@value": "People belonging to any of various population groups of especially African ancestry often considered as having dark pigmentation of the skin but in fact having a wide range of skin colours."
            },
            "cids:hasDescription": "People belonging to any of various population groups of especially African ancestry often considered as having dark pigmentation of the skin but in fact having a wide range of skin colours.",
