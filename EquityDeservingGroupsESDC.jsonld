            "prov:hadPrimarySource": {
                "@id": "https://www.noslangues-ourlanguages.gc.ca/en/publications/equite-diversite-inclusion-equity-diversity-inclusion-eng#notion-69399"
            },
            "skos:notation": "edg4",
            "org:hasIdentifier": "edg4",
            "skos:definition": {
                "@language": "en",
                "@value": "In Canada, Indigenous people who are part of a First Nation or whose ancestors were part of a First Nation. A First Nation person can be a Status or Non-Status Indian."
            },
            "cids:hasDescription": "In Canada, Indigenous people who are part of a First Nation or whose ancestors were part of a First Nation. A First Nation person can be a Status or Non-Status Indian.",
            "skos:prefLabel": {
                "@language": "en",
                "@value": "Indigenous Peoples: First Nations"
            },
            "org:hasName": "Indigenous Peoples: First Nations",
            "@type": [
                "cids:PopulationServed",
                "cids:EquityDeservingGroup"
            ]
        },
        {
            "@id": "https://codelist.commonapproach.org/EquityDeservingGroupsESDC#edg3",
            "skos:inScheme": {
                "@id": "https://codelist.commonapproach.org/EquityDeservingGroupsESDC"
            },
            "rdfs:isDefinedBy": {
                "@id": "https://codelist.commonapproach.org/EquityDeservingGroupsESDC"
            },
            "cids:hasSpecification": {
                "@id": "https://codelist.commonapproach.org/EquityDeservingGroupsESDC"
            },
            "cids:definedBy": {
                "@id": "cids:esdc"
            },
            "skos:notation": "edg3",
            "org:hasIdentifier": "edg3",
            "skos:definition": {
                "@language": "en",
                "@value": "People who were born outside Canada. For the most part, these are people who are now, or once were, immigrants to Canada. People who were forced to flee from persecution in their home country. This includes Convention refugees (as defined by the Immigration and Refugee Protection Act (S.C. 2001, c. 27)) and asylum-seekers or refugee claimants. Immigrants and Refugees that have been in Canada for less than five years."
            },
            "cids:hasDescription": "People who were born outside Canada. For the most part, these are people who are now, or once were, immigrants to Canada. People who were forced to flee from persecution in their home country. This includes Convention refugees (as defined by the Immigration and Refugee Protection Act (S.C. 2001, c. 27)) and asylum-seekers or refugee claimants. Immigrants and Refugees that have been in Canada for less than five years.",
            "skos:prefLabel": {
                "@language": "en",
                "@value": "First Generation Immigrants, Refugees & Newcomers"
            },
            "org:hasName": "First Generation Immigrants, Refugees & Newcomers",
            "@type": [
                "cids:PopulationServed",
                "cids:EquityDeservingGroup"
            ]
        },
