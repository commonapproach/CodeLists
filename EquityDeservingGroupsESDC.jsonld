            "cids:definedBy": {
                "@id": "cids:esdc"
            },
            "prov:hadPrimarySource": {
                "@id": "https://www.canada.ca/en/women-gender-equality/free-to-be-me/2slgbtqi-plus-glossary.html"
            },
            "skos:notation": "edg11",
            "org:hasIdentifier": "edg11",
            "skos:definition": {
                "@language": "en",
                "@value": "People whose gender identity does not align with a binary understanding of gender such as man or woman. It is a gender identity which may include man and woman, androgynous, fluid, multiple, no gender, or a different gender outside of the “woman—man” spectrum."
            },
            "cids:hasDescription": "People whose gender identity does not align with a binary understanding of gender such as man or woman. It is a gender identity which may include man and woman, androgynous, fluid, multiple, no gender, or a different gender outside of the “woman—man” spectrum.",
            "skos:prefLabel": {
                "@language": "en",
                "@value": "Gender Diverse People: Non-Binary"
            },
            "org:hasName": "Gender Diverse People: Non-Binary",
            "@type": [
                "cids:PopulationServed",
                "cids:EquityDeservingGroup"
            ]
        },
