        {
            "@id": "https://codelist.commonapproach.org/EquityDeservingGroupsESDC#edg11",
            "skos:inScheme": {
                "@id": "https://codelist.commonapproach.org/EquityDeservingGroupsESDC"
            },
            "rdfs:isDefinedBy": {
                "@id": "https://codelist.commonapproach.org/EquityDeservingGroupsESDC"
